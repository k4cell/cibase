# Copie este arquivo para ".env" (sem o ".example") e preencha com os valores
# reais do seu projeto Supabase (Project → Connect → aba "Shared pooler").
# O ".env" nunca deve ser commitado -- ele já está no .gitignore.

DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_ID_DE_PROJETO_AQUI
DB_PASSWORD=SUA_SENHA_AQUI
